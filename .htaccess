<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to existing files (like test.html) and directories (like /dashboard)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route GDPS API endpoints safely to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
