<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to real files (e.g., /test.html, /db-test.php)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all root requests to dashboard/index.php
    RewriteRule ^(.*)$ dashboard/index.php [QSA,L]
</IfModule>
